PORT=4000
# Random long string used to sign login sessions (tokens). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required outside local development — without it the server falls back to an
# insecure built-in secret and logs a warning on startup.
AUTH_SECRET=

# First admin, created on startup only when there are no users yet
# (users.json is not in git, so every fresh deploy needs this).
# Password: at least 12 characters. Do not reuse admin123 — it was public.
ADMIN_EMAIL=
ADMIN_PASSWORD=
